{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ccboat",
  "version": "0.2.1",
  "identifier": "app.ccboat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ccboat",
        "width": 1440,
        "height": 880,
        "minWidth": 900,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "publisher": "Ccboat",
    "copyright": "Copyright (c) 2026 Yash Desai. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "Watch a Claude Code session as an IDE",
    "longDescription": "Ccboat: a read-only, IDE-style view of a Claude Code session, live as it works or replayed step by step."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNjMzMjgxREMxMjE2NjEKUldSaEZoTGNnVEpqb2ZMZlQ1NUlsZHp1aHNBbjQrUGFPdUhBMERQdWp6TGwwdkg4TUJQNlFuNkIK",
      "endpoints": [
        "https://github.com/yash-desai-naik/ccboat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
